# Enforce line endings so shell scripts stay executable via `curl | bash`
# even if a Windows contributor has core.autocrlf=true.
* text=auto

# Shell / installer scripts — always LF (CRLF breaks bash shebangs).
*.sh text eol=lf
install.sh text eol=lf

# PowerShell — CRLF is the Windows convention (and harmless for pwsh on Unix).
*.ps1 text eol=crlf
install.ps1 text eol=crlf

# Binary assets — never touch.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.node binary
*.so binary
*.dll binary
*.dylib binary
