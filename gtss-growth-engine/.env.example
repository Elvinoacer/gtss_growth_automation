# ─────────────────────────────────────────────────────────────────────────────
# GTSS Growth Engine — environment template
#
# Copy to .env and fill in values, or run `npm run setup` which generates a
# starter .env with a default passphrase.
#
# When running under the desktop launcher, these paths are overridden to
# point into the writable userData directory (see desktop/main/env-bootstrap.js).
# The keys listed here match what EnvBootstrap.writeInitialEnv() writes.
# ─────────────────────────────────────────────────────────────────────────────

SESSION_SECRET=
PASSPHRASE_HASH=
ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GMAIL_USER=
GMAIL_APP_PASSWORD=
PORT=3000

# ── Writable paths (relative to engine root in standalone/dev mode) ──────────
DB_PATH=./data/gtss.db
SESSION_DIR=./sessions
AUTOMATION_ARTIFACTS_DIR=./artifacts/automation
DOM_CAPTURE_DIR=./artifacts/dom-captures
GEMINI_IMAGE_SAVE_DIR=./artifacts/gemini-images
AUTOMATION_LOCKS_DIR=./data/browser-locks
UPLOADS_DIR=./public/uploads
MEDIA_DIR=./media
CDP_PROFILE_DIR=./chrome-cdp-profile
PROFILES_DIR=./profiles

# ── Browser automation ───────────────────────────────────────────────────────
# persistent = Playwright launches a dedicated Chrome profile per platform.
# cdp = connect to a Chrome launched with --remote-debugging-port (desktop
#       launcher default).
BROWSER_MODE=cdp
BROWSER_CHANNEL=chrome
CDP_ENDPOINT=http://127.0.0.1:9222
CDP_PORT=9222
# Whether CDP Chrome runs visibly or headless on normal Starts.
# First Start always runs visibly for sign-in; after that this applies.
CDP_VISIBLE_DEFAULT=false
# Localhost-only bridge HTTP server (desktop launcher ↔ web app control).
GTSS_BRIDGE_PORT=9224
SESSION_MAX_AGE_HOURS=720
AUTOMATION_ACTION_DELAY_MS=60000,180000
PLAYWRIGHT_TRACE=true
# Keep false for production social automation.
ALLOW_HEADLESS_SOCIAL=false
ACTION_IDEMPOTENCY_TTL_HOURS=168
SHUTDOWN_TIMEOUT_MS=30000

# ── LinkedIn outreach mode ───────────────────────────────────────────────────
# connect_first = connection request first, then DM after accept.
# dm_first = try Message button first; snooze if unavailable.
# dm_only = only attempt direct DMs.
LINKEDIN_OUTREACH_MODE=connect_first

# ── Pipeline mode ────────────────────────────────────────────────────────────
# Global default. Each stage can override via its own _MODE variable.
# Values: ai | manual
PIPELINE_MODE=ai

# Per-stage overrides (leave blank to inherit PIPELINE_MODE)
DISCOVERY_MODE=
QUALIFICATION_MODE=
MESSAGE_MODE=
SEND_MODE=

# ── Qualification ────────────────────────────────────────────────────────────
QUALIFICATION_THRESHOLD=50
QUALIFICATION_MANUAL_SCORE=75

# ── Message generation ───────────────────────────────────────────────────────
MESSAGE_AUTO_APPROVE_VARIANT=B

# ── Pipeline scheduler ───────────────────────────────────────────────────────
PIPELINE_CRON=0 8 * * *
PIPELINE_DISCOVERY_KEYWORDS_FILE=./src/config/keywords.json
