SESSION_SECRET=
PASSPHRASE_HASH=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GMAIL_USER=
GMAIL_APP_PASSWORD=
DB_PATH=./data/gtss.db
SESSION_DIR=./sessions
ENCRYPTION_KEY=

# Browser automation
# persistent = Playwright launches a dedicated Chrome profile per platform.
# cdp = connect to a manually launched Chrome with --remote-debugging-port.
BROWSER_MODE=persistent
BROWSER_CHANNEL=chrome
# CDP_ENDPOINT=http://localhost:9222
# LINKEDIN_USER_DATA_DIR=./profiles/linkedin
SESSION_MAX_AGE_HOURS=720
AUTOMATION_ARTIFACTS_DIR=./artifacts/automation
AUTOMATION_LOCKS_DIR=./data/browser-locks
AUTOMATION_ACTION_DELAY_MS=60000,180000
PLAYWRIGHT_TRACE=true
# Keep false for production social automation.
ALLOW_HEADLESS_SOCIAL=false
ACTION_IDEMPOTENCY_TTL_HOURS=168

# LinkedIn outreach mode:
# connect_first = send a connection request first, then DM after connection is accepted.
# dm_first = try a direct Message button first; if unavailable, snooze as not_connected.
# dm_only = only attempt direct DMs for LinkedIn.
LINKEDIN_OUTREACH_MODE=connect_first
SHUTDOWN_TIMEOUT_MS=30000
